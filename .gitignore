# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment. Every env file is ignored by default; the committed .env is un-ignored by
# negation. It holds only declared config and 1Password op:// references — `npm run check:env`
# (part of check:all) fails on anything else. Any other env file (scratch copies, .env.local, …)
# stays out.
.env*
!.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
.vitest/

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Vite / cache
.vite/
.cache/

# Misc
.tmp/
tmp/

# Generated spec HTML views (regenerate with `npm run spec:html`)
specs/**/*.html

# Client section landing pages — generated by scripts/build-sections.mjs at build time
src/web/public/work/*/index.html

# Favicons and the social card — copied from the brand package by scripts/copy-brand-assets.mjs at build time
src/web/public/favicon.svg
src/web/public/favicon.ico
src/web/public/apple-touch-icon.png
src/web/public/social.png

# The page kit as one stylesheet for hosted pages — written by scripts/copy-brand-assets.mjs at build time
src/web/public/kit/
